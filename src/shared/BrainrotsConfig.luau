local DEFAULT_VARIANT = "Normal"
local FALLBACK_ICON = "rbxasset://textures/ui/GuiImagePlaceholder.png"

local VARIANT_ALIASES: { [string]: string } = {
	["normal"] = "Normal",
	["default"] = "Normal",

	["gold"] = "Golden",
	["golden"] = "Golden",

	["diamond"] = "Diamond",
	["lava"] = "Lava",
	["galaxy"] = "Galaxy",
	["rainbow"] = "Rainbow",
}

local RARITY_ORDER: { [string]: number } = {
	["common"] = 1,
	["uncommon"] = 2,
	["rare"] = 3,
	["epic"] = 4,
	["mythic"] = 5,
	["legendary"] = 6,
	["brainrot god"] = 7,
	["secret"] = 8,
}

local Methods = {}

function Methods:NormalizeVariant(variant: string?): string
	if typeof(variant) ~= "string" or variant == "" then
		return DEFAULT_VARIANT
	end

	local lowered = string.lower(variant)
	return VARIANT_ALIASES[lowered] or variant
end

function Methods:Exists(brainrotName: string): boolean
	return rawget(Config, brainrotName) ~= nil
end

function Methods:Get(brainrotName: string): { rarity: string, baseIncome: number, icons: { [string]: string } }?
	local data = rawget(Config, brainrotName)
	if typeof(data) ~= "table" then
		return nil
	end

	return data :: any
end

function Methods:GetRarity(brainrotName: string): string?
	local data = self:Get(brainrotName)
	return if data then data.rarity else nil
end

function Methods:GetBaseIncome(brainrotName: string): number?
	local data = self:Get(brainrotName)
	return if data then data.baseIncome else nil
end

function Methods:GetIcons(brainrotName: string): { [string]: string }?
	local data = self:Get(brainrotName)
	return if data then data.icons else nil
end

function Methods:GetIcon(brainrotName: string, variant: string?): string
	local data = self:Get(brainrotName)
	if not data then
		return FALLBACK_ICON
	end

	local icons = data.icons
	if typeof(icons) ~= "table" then
		return FALLBACK_ICON
	end

	local normalizedVariant = self:NormalizeVariant(variant)
	return icons[normalizedVariant] or icons[DEFAULT_VARIANT] or FALLBACK_ICON
end

function Methods:GetNormalIcon(brainrotName: string): string
	return self:GetIcon(brainrotName, DEFAULT_VARIANT)
end

function Methods:GetNames(): { string }
	local names = {}

	for brainrotName, data in pairs(Config) do
		if typeof(brainrotName) == "string" and typeof(data) == "table" then
			table.insert(names, brainrotName)
		end
	end

	table.sort(names)
	return names
end

function Methods:GetByRarity(rarity: string): { string }
	local names = {}
	local wanted = string.lower(rarity)

	for brainrotName, data in pairs(Config) do
		if typeof(brainrotName) == "string" and typeof(data) == "table" then
			local entry = data :: any
			if typeof(entry.rarity) == "string" and string.lower(entry.rarity) == wanted then
				table.insert(names, brainrotName)
			end
		end
	end

	table.sort(names)
	return names
end

function Methods:GetSortedByIncome(descending: boolean?): { string }
	local names = self:GetNames()

	table.sort(names, function(a, b)
		local aIncome = self:GetBaseIncome(a) or 0
		local bIncome = self:GetBaseIncome(b) or 0

		if aIncome == bIncome then
			return a < b
		end

		if descending == true then
			return aIncome > bIncome
		end

		return aIncome < bIncome
	end)

	return names
end

function Methods:GetSortedByRarity(): { string }
	local names = self:GetNames()

	table.sort(names, function(a, b)
		local aData = self:Get(a)
		local bData = self:Get(b)
		local aRank = if aData then RARITY_ORDER[aData.rarity] or 999 else 999
		local bRank = if bData then RARITY_ORDER[bData.rarity] or 999 else 999

		if aRank == bRank then
			local aIncome = self:GetBaseIncome(a) or 0
			local bIncome = self:GetBaseIncome(b) or 0

			if aIncome == bIncome then
				return a < b
			end

			return aIncome < bIncome
		end

		return aRank < bRank
	end)

	return names
end

function Methods:GetRandomName(rng: Random?): string?
	local names = self:GetNames()
	if #names == 0 then
		return nil
	end

	local randomObject = rng or Random.new()
	return names[randomObject:NextInteger(1, #names)]
end

function Methods:GetRandomByRarity(rarity: string, rng: Random?): string?
	local names = self:GetByRarity(rarity)
	if #names == 0 then
		return nil
	end

	local randomObject = rng or Random.new()
	return names[randomObject:NextInteger(1, #names)]
end

function Methods:GetHighestIncomeBrainrot(): string?
	local sorted = self:GetSortedByIncome(true)
	return sorted[1]
end

function Methods:GetLowestIncomeBrainrot(): string?
	local sorted = self:GetSortedByIncome(false)
	return sorted[1]
end

function Methods:HasIcon(brainrotName: string, variant: string?): boolean
	local data = self:Get(brainrotName)
	if not data then
		return false
	end

	local icons = data.icons
	local normalizedVariant = self:NormalizeVariant(variant)
	return typeof(icons[normalizedVariant]) == "string" and icons[normalizedVariant] ~= ""
end

function Methods:GetMissingIconNames(requiredVariants: { string }?): { string }
	local missing = {}
	local variants = requiredVariants or { "Normal", "Golden", "Diamond", "Lava", "Galaxy", "Rainbow" }

	for _, brainrotName in ipairs(self:GetNames()) do
		for _, variant in ipairs(variants) do
			if not self:HasIcon(brainrotName, variant) then
				table.insert(missing, brainrotName .. "/" .. self:NormalizeVariant(variant))
			end
		end
	end

	return missing
end

function Methods:GetAllSorted()
	local rarityOrder = {
		common = 1,
		uncommon = 2,
		rare = 3,
		epic = 4,
		mythic = 5,
		legendary = 6,
		["brainrot god"] = 7,
		secret = 8,
	}

	local variantOrder = {
		"Normal",
		"Golden",
		"Diamond",
		"Lava",
		"Galaxy",
		"Rainbow",
	}

	local list = {}

	for brainrotName, data in pairs(self) do
		if typeof(data) ~= "table" then
			continue
		end

		if typeof(data.rarity) ~= "string" or typeof(data.baseIncome) ~= "number" then
			continue
		end

		local orderedIcons = {}

		if typeof(data.icons) == "table" then
			for _, variantName in ipairs(variantOrder) do
				local icon = data.icons[variantName]

				if typeof(icon) == "string" and icon ~= "" then
					orderedIcons[variantName] = icon
				end
			end
		end

		table.insert(list, {
			name = brainrotName,
			rarity = data.rarity,
			baseIncome = data.baseIncome,
			icons = orderedIcons,
		})
	end

	table.sort(list, function(a, b)
		local rarityA = rarityOrder[string.lower(a.rarity)] or 999
		local rarityB = rarityOrder[string.lower(b.rarity)] or 999

		if rarityA ~= rarityB then
			return rarityA < rarityB
		end

		if a.baseIncome ~= b.baseIncome then
			return a.baseIncome < b.baseIncome
		end

		return a.name < b.name
	end)

	return list
end

setmetatable(Config, {
	__index = Methods,
})

return Config
